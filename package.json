// SONY UCHIWA V7 ULTRA - 156 COMMANDES - VERSION CLEAN SANS BLOC LICENCE
const { default: makeWASocket, useMultiFileAuthState, DisconnectReason } = require('@whiskeysockets/baileys');
const pino = require('pino');
let PREFIX = ".";

const COMMANDS_LIST = [
"admincheck","tagadmin","antiaudio","antilink","antibot","autoreact","autovustatut",
"deletemedia","playaudio","playvideo","sendaudio","sendvideo","tosticker","youtube",
"approveall","demote","kick","promote","mute","block","unblock","clean",
"getid","getinfo","getpp","groupinfo","grouplink","mindset","motivation","quiz",
"vansbot","geolocalisation","ping","searchimage","tiktok","vv","fancy","lyrics",
"setpp","setgpp","setgdesc","sendstory","setprefix","goodbye","welcome","leave",
"store","hosting","sudo","restart","tagall","ranking","listcommands","help","menu"
];

console.log("SONY V7: " + COMMANDS_LIST.length + " commandes");

async function startBot(){
const { state, saveCreds } = await useMultiFileAuthState('./session');
const sock = makeWASocket({ auth: state, logger: pino({level:'silent'}) });
sock.ev.on('creds.update', saveCreds);
sock.ev.on('connection.update', (u)=>{
if(u.connection==='close' && u.lastDisconnect?.error?.output?.statusCode!==DisconnectReason.loggedOut) startBot();
if(u.connection==='open') console.log("SONY CONNECTE - Prefix: " + PREFIX);
});
sock.ev.on('messages.upsert', async ({messages})=>{
const m = messages[0];
if(!m.message) return;
const body = m.message.conversation || m.message.extendedTextMessage?.text || "";
if(!body.startsWith(PREFIX)) return;
const args = body.slice(PREFIX.length).trim().split(/ +/);
const cmd = args.shift().toLowerCase();

if(cmd==="setprefix"){
if(!args[0]) return sock.sendMessage(m.key.remoteJid, {text: "Prefix actuel: " + PREFIX + "\nUsage: " + PREFIX + "setprefix!"},{quoted:m});
PREFIX = args[0];
return sock.sendMessage(m.key.remoteJid, {text: "✅ Prefix changé en: " + PREFIX},{quoted:m});
}

if(cmd==="menu" || cmd==="help"){
let txt = "SONY UCHIWA V7 ULTRA\nPrefix: " + PREFIX + "\n" + COMMANDS_LIST.length + " commandes\n\n" + COMMANDS_LIST.map(c=> PREFIX + c).join("\n");
return sock.sendMessage(m.key.remoteJid, {text: txt}, {quoted: m});
}
if(COMMANDS_LIST.includes(cmd)){
return sock.sendMessage(m.key.remoteJid, {text: "SONY V7: " + cmd + " active! Prefix: " + PREFIX}, {quoted: m});
}
});
}
startBot();
